# Sao chép file này thành .env rồi điền giá trị thật.
# .env đã nằm trong .gitignore, không commit thông tin bí mật.

GEMINI_API_KEY=

# SMTP — điền tài khoản gửi email thật.
# Để trống SMTP_USER/SMTP_PASSWORD để chạy chế độ mock (in email ra log).
# Gmail: bật 2FA và dùng App Password, không dùng mật khẩu đăng nhập thường.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true nếu dùng cổng 465 (SSL); false nếu dùng 587 (STARTTLS).
SMTP_USE_SSL=false
SMTP_TIMEOUT=15
# Số lần thử lại tối đa và thời gian chờ ban đầu (giây) giữa các lần thử.
SMTP_MAX_RETRIES=3
SMTP_RETRY_DELAY=2
