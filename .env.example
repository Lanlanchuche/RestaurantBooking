# Sao chép file này thành .env rồi điền giá trị thật.
# .env đã nằm trong .gitignore, không commit thông tin bí mật.

GEMINI_API_KEY=

# Cách gửi email:
#   auto (mặc định) — ưu tiên HTTPS API nếu có API key, sau đó SMTP, cuối cùng mock
#   resend | sendgrid | brevo — gửi qua HTTPS API (khuyến nghị khi deploy lên Render)
#   smtp — gửi qua SMTP (chỉ dùng khi máy chủ cho phép cổng 25/465/587)
#   mock — chỉ in email ra log
EMAIL_PROVIDER=auto

# Địa chỉ gửi hiển thị trên email. Với Resend/SendGrid/Brevo, địa chỉ này phải
# là sender/domain đã xác thực trong tài khoản của nhà cung cấp.
# Để trống thì dùng SMTP_USER (nếu có).
EMAIL_FROM=

# API key HTTPS — chỉ cần điền key của nhà cung cấp bạn dùng.
# Render Free chặn cổng SMTP nên đây là cách gửi email hoạt động được.
RESEND_API_KEY=
SENDGRID_API_KEY=
BREVO_API_KEY=

# Timeout / số lần thử lại cho cả HTTPS API và SMTP.
# Nếu để trống, dùng SMTP_TIMEOUT / SMTP_MAX_RETRIES / SMTP_RETRY_DELAY.
EMAIL_TIMEOUT=15
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_DELAY=2

# SMTP — điền tài khoản gửi email thật.
# Để trống SMTP_USER/SMTP_PASSWORD để chạy chế độ mock (in email ra log).
# Gmail: bật 2FA và dùng App Password, không dùng mật khẩu đăng nhập thường.
# Lưu ý: Render Free chặn outbound tới cổng 25/465/587 (từ 26/09/2025).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true nếu dùng cổng 465 (SSL); false nếu dùng 587 (STARTTLS).
SMTP_USE_SSL=false
SMTP_TIMEOUT=15
# Số lần thử lại tối đa và thời gian chờ ban đầu (giây) giữa các lần thử.
SMTP_MAX_RETRIES=3
SMTP_RETRY_DELAY=2
